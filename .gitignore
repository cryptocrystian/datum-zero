# deps
node_modules/
.pnpm-store/

# env / secrets
.env
.env.*
!.env.example

# builds
dist/
.next/
out/
build/
*.tsbuildinfo

# python
__pycache__/
*.pyc
.venv/
.venv-training/
services/inference/.venv/
services/inference/.venv-training/

# prisma local
/packages/db/prisma/*.db

# local object storage (StoragePort filesystem fallback)
.data/

# graphify (regenerated artifact)
graphify-out/

# DJI Thermal SDK + the confidential DJI wrapper (DJI EULA §14, CR-22) — NEVER commit
services/inference/app/radiometric/_dji_sdk_native.py
services/inference/vendor/dji-thermal-sdk/
**/libdirp*

# per-machine agent / hook config (Claude Code settings + graphify hook paths) — stays local.
# NOTE: .claude/skills/** ARE tracked (project assets — architect/design/graphify); only local,
# never-committed tooling is ignored here.
.claude/settings.json
.claude/settings.local.json
.claude/CLAUDE.md
.claude/launch.json

# Terraform (M2-6c) — provider cache + STATE never committed. State can contain resource metadata and
# secret material; it lives in the S3 backend. `.terraform.lock.hcl` IS committed (deterministic
# provider versions). Real values live in tfvars, which stay local — only *.tfvars.example is tracked.
**/.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
*.tfvars.json
!*.tfvars.example
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# misc
.DS_Store
*.log
