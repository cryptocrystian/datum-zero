# Copy to .env and fill. NEVER commit real secrets (MANIFEST §3 / CLAUDE.md).
# Secrets in production come from AWS Secrets Manager, not this file.

# --- Database (matches docker-compose) ---
DATABASE_URL="postgresql://dz:dz_local_dev@localhost:5432/datum_zero"

# --- Redis / BullMQ ---
REDIS_URL="redis://localhost:6379"

# --- Services ---
WEB_URL="http://localhost:3000"
INFERENCE_URL="http://localhost:8000"
# Next.js backend endpoint the inference service calls back into:
INFERENCE_CALLBACK_URL="http://localhost:3000/api/v1/inference/callback"
# Shared secret for the internal inference -> web callback (both services read it).
# LOCAL DEV ONLY — rotate/replace in prod (AWS Secrets Manager).
INFERENCE_CALLBACK_TOKEN="dev-inference-callback-token"

# --- Object storage (StoragePort — MANIFEST §3) ---
# Driver: "s3" (MinIO/S3, the default) or "local" (filesystem fallback for dev without MinIO).
STORAGE_DRIVER="s3"
STORAGE_LOCAL_ROOT=".data/object-store"
S3_BUCKET="datum-zero-dev"
S3_REGION="us-east-1"
S3_ENDPOINT="http://localhost:9000"   # MinIO endpoint; LEAVE UNSET in prod to use real AWS S3
S3_FORCE_PATH_STYLE="true"            # required for MinIO
# LOCAL DEV ONLY — prod resolves creds via IAM role / AWS Secrets Manager, never these values:
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"

# --- Cockpit map (M0-08) ---
# Mapbox GL JS dark vector map for the coordinate inset. Optional in dev — without it the cockpit
# renders the branded concentric-ring target fallback. Publishable token only (pk.*), never a secret key.
NEXT_PUBLIC_MAPBOX_TOKEN=""

# --- Ingestion API (M0-04) ---
# Bearer token for the authenticated upload endpoint. LOCAL DEV ONLY — rotate/replace in prod.
INGEST_API_TOKEN="dev-ingest-token"
