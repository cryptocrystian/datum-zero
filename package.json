{
  "name": "datum-zero",
  "private": true,
  "version": "0.0.0",
  "description": "Datum Zero Systems — Autonomous Reality Ledger Reconciliation (monorepo)",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n web,infer -c blue,green \"pnpm --filter @dz/web dev\" \"pnpm run dev:infer\"",
    "dev:web": "pnpm --filter @dz/web dev",
    "dev:infer": "cd services/inference && uv run $([ -f ../../.env ] && echo --env-file ../../.env) uvicorn app.main:app --reload --port 8000",
    "worker": "pnpm --filter @dz/db exec tsx ../../apps/web/lib/outbox/worker-main.ts",
    "build": "pnpm -r --filter ./apps/* build",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "db:generate": "pnpm --filter @dz/db exec prisma generate",
    "db:migrate": "pnpm --filter @dz/db exec prisma migrate dev",
    "db:seed": "pnpm --filter @dz/db run seed",
    "test:guardrails": "pytest tests/guardrails -q"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0"
  },
  "pnpm": {
    "overrides": {
      "@auth/core": "0.40.0",
      "ioredis": "5.10.1"
    }
  }
}
